# Spam filter API: server-only secrets. Keep real values in apps/web/.env.local.
AI_GATEWAY_API_KEY=
API_AUTH_TOKEN=
JEV_TIMEOUT_MS=10000

# Shared portfolio and CANCELDT backend.
NEXT_PUBLIC_CONVEX_URL=

# Jarvis keeps its independent backend. This URL is server-only.
JARVIS_CONVEX_URL=
JARVIS_GATEWAY_SECRET=
JARVIS_SESSION_SECRET=
JARVIS_PUBLIC_ORIGIN=https://juicecolored.localhost

# CANCELDT keeps its independent owner credentials and path-scoped session.
CANCELDT_PUBLIC_ORIGIN=https://juicecolored.localhost
CANCELDT_AUTH_ISSUER=https://juicecolored.localhost/canceldt
CANCELDT_AUTH_PRIVATE_KEY=
CANCELDT_AUTH_PUBLIC_JWKS=
CANCELDT_LOGIN_SECRET=
CANCELDT_REVALIDATE_SECRET=
NEXT_PUBLIC_CANCELDT_TURNSTILE_SITE_KEY=
