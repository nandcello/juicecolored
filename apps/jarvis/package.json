{
  "name": "@personal/jarvis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3001",
    "build": "vp run typecheck && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "next typegen && node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vp test run --config vitest.config.mts",
    "lint": "eslint .",
    "convex:dev": "convex dev",
    "deploy": "convex deploy --cmd 'vp run build'",
    "format": "vp fmt .",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "convex": "^1.46.0",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "^0.0.59",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
