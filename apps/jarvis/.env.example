# Public browser origin, without a trailing slash. Production: https://juicecolored.com
JARVIS_PUBLIC_ORIGIN=https://juicecolored.localhost
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Set matching values in Vercel and Convex. Never prefix these with NEXT_PUBLIC_.
JARVIS_GATEWAY_SECRET=
JARVIS_SESSION_SECRET=
# Convex only: owner passphrase hash and AES-256 session encryption key.
# See scripts/setup-secrets.mjs; generated credentials stay in .env.credentials.local.
JARVIS_PASSWORD_HASH=
XIAOMI_ENCRYPTION_KEY=
