{
  "name": "personal",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -F @personal/web dev",
    "dev:web": "vp run -F @personal/web dev",
    "dev:convex": "vp run -F @personal/convex dev",
    "dev:mobile": "vp run -F @personal/mobile start",
    "go:testflight": "vp run -F @personal/mobile go:testflight",
    "build": "vp run -F @personal/web build",
    "preview": "vp run -F @personal/web preview",
    "check": "vp check && vp run -F @personal/mobile lint",
    "test": "vp test run",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
