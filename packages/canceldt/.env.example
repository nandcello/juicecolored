NEXT_PUBLIC_CONVEX_URL=
CANCELDT_PUBLIC_ORIGIN=https://juicecolored.com
# Independent server-only credential shared with the CANCELDT login action.
CANCELDT_LOGIN_SECRET=
CANCELDT_AUTH_ISSUER=https://juicecolored.com/canceldt
CANCELDT_AUTH_PRIVATE_KEY=
CANCELDT_AUTH_PUBLIC_JWKS=
CANCELDT_REVALIDATE_SECRET=
NEXT_PUBLIC_CANCELDT_TURNSTILE_SITE_KEY=
# Convex deployment environment (not Next public variables):
# CANCELDT_AUTH_ISSUER, CANCELDT_AUTH_JWKS (public JWKS data URI)
# CANCELDT_ADMIN_IDENTITIES=https://juicecolored.com/canceldt|canceldt-owner
# CANCELDT_PASSPHRASE_HASH, CANCELDT_LOGIN_SECRET
# CANCELDT_TURNSTILE_SECRET, CANCELDT_REPORT_HOSTNAMES=juicecolored.com
# Main web app build environment:
# CANCELDT_ORIGIN=https://your-canceldt-project.vercel.app
