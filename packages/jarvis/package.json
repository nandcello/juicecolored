{
  "name": "@personal/jarvis",
  "private": true,
  "type": "module",
  "exports": {
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./domain": "./domain.ts",
    ".": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./*": "./src/*",
    "./app/layout": "./src/app/layout.tsx",
    "./app/metadata": "./src/app/metadata.ts",
    "./app/not-found": "./src/app/not-found.tsx",
    "./app/not-found-document": "./src/app/not-found-document.tsx",
    "./app/page": "./src/app/page.tsx",
    "./app/route": "./src/app/route.ts",
    "./components/dashboard": "./src/components/dashboard.tsx",
    "./components/welcome": "./src/components/welcome.tsx",
    "./lib/domain": "./src/lib/domain.ts"
  },
  "scripts": {
    "codegen": "convex codegen",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --incremental false",
    "test": "vp test run --config vitest.config.ts",
    "lint": "eslint .",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:auth": "playwright test --config tests/playwright.auth.config.ts"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.0",
    "convex": "^1.46.0",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.59",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite-plus": "0.3.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "next": "16.3.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}
