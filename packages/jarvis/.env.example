# Select Jarvis's independent Convex deployment for package CLI commands.
CONVEX_DEPLOYMENT=

# Backend-only values live in the Convex deployment. setup-secrets.mjs creates
# a private .env.credentials.local and can configure the deployment explicitly.
JARVIS_GATEWAY_SECRET=
JARVIS_PASSWORD_HASH=
XIAOMI_ENCRYPTION_KEY=

# Next runtime variables (JARVIS_CONVEX_URL, JARVIS_GATEWAY_SECRET,
# JARVIS_SESSION_SECRET, JARVIS_PUBLIC_ORIGIN) belong in apps/web/.env.local.
# See apps/web/.env.example. Match JARVIS_PUBLIC_ORIGIN to `portless list`.
